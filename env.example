# انسخ هذا الملف إلى .env وعدّل القيم

# رابط قاعدة بيانات PostgreSQL من Supabase (من إعدادات المشروع > Database > Connection string)
# إذا تركته فارغاً يعمل النظام بوضع تجريبي محلي ويحفظ البيانات في ملف data.json
DATABASE_URL=

# بيانات دخول المدير (غيّرها قبل النشر)
ADMIN_USER=admin
ADMIN_PASSWORD=change-me-123

# كلمة سر لتوقيع جلسات الدخول (أي نص طويل عشوائي)
AUTH_SECRET=put-a-long-random-text-here

# المنفذ (Render يضبطه تلقائياً)
PORT=3000
